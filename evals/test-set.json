{
  "agent_url": "https://zafsrwwwrbwu.run.agentplace.io/",
  "notes": "Each case is one fresh conversation. 'turns' are the customer's messages in order. Checks run on the agent's reply to each turn (regexes are case-insensitive). 'calls' lists the API requests the case must produce, as 'STATUS PATH', matched against the API's logs; 'calls_forbidden' lists requests that must NOT succeed. Global checks in grade.mjs apply to every reply.",
  "allowed_amounts": [
    32,
    68,
    95,
    96,
    159,
    189,
    231,
    249,
    257,
    313,
    344,
    348,
    429
  ],
