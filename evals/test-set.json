    {
      "id": "stock-in",
      "category": "core",
      "turns": [
        {
          "say": "Is the Summit Shell Jacket in blue, size M in stock?",
          "must": [
            "in stock"
          ],
          "must_not": [
            "out of stock"
          ]
        }
      ],
      "calls": [
        "200 /v1/stock/RDG-1001"
      ]
    },
    {
      "id": "stock-low",
      "category": "core",
