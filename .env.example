# Neon Postgres connection string. Leave empty to run on the built-in in-memory sample data.
DATABASE_URL=

# API key the Agentplace store agent sends (scopes: stock:read, orders:read).
# Generate one with: node -e "console.log('rdg_live_' + require('crypto').randomBytes(24).toString('hex'))"
AGENT_API_KEY=

# A second key with only stock:read, used to demonstrate a scope refusal.
STOCK_ONLY_API_KEY=

PORT=3000
